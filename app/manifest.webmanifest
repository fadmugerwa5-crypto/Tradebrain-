{
  "name": "ClassPulse — Every lesson, accounted for",
  "short_name": "ClassPulse",
  "description": "Teacher arrival, lesson attendance and time-in/time-out for a school's Director of Studies, with QR scans, automatic escalation and NCDC lesson planning.",
  "id": "classpulse",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#070b18",
  "theme_color": "#070b18",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "productivity", "business"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-64.png", "sizes": "64x64", "type": "image/png" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Scan a code", "short_name": "Scan", "url": "./index.html#/teacher/scan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "DOS live pulse", "short_name": "Pulse", "url": "./index.html#/dos/pulse", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My alerts", "short_name": "Alerts", "url": "./index.html#/dos/staff", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
